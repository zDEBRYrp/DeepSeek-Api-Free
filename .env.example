# Ключ Fernet генерируется автоматически при первом запуске, если не задан здесь.
FERNET_KEY=

CHAT_URL=https://chat.deepseek.com/
# true — браузер невидим (фоновый режим, сессия восстанавливается из data/sessions.sqlite3).
# false — открывается видимое окно браузера; используйте для ПЕРВИЧНОГО ручного входа.
HEADLESS=true
COOKIE_FILE=./cookies.txt
BROWSER_CHANNEL=chrome
ANTIDETECT=patchright
# Постоянный профиль браузера: реальные (httpOnly) куки и localStorage сохраняются на диске.
USER_DATA_DIR=./pw_profile
# Зашифрованное хранилище сессии (SQLite, Fernet). Исключено из git.
DB_PATH=./data/sessions.sqlite3

HOST=0.0.0.0
PORT=8000

# Время ожидания ручного входа (мс) при HEADLESS=false (окно браузера).
LOGIN_WAIT_TIMEOUT_MS=300000
NAV_TIMEOUT_MS=30000
RESPONSE_TIMEOUT_MS=300000
ACTION_TIMEOUT_MS=10000

# Очередь запросов: сколько секунд ждать свободного слота генерации,
# прежде чем вернуть HTTP 429 (одновременно поддерживается 1 запрос).
REQUEST_QUEUE_TIMEOUT=2.0

# Максимальная длина сообщения (символов). 0 = без лимита (DeepSeek сам
# обрабатывает длинные вставки, преобразуя их в .txt-вложение).
MAX_MESSAGE_LENGTH=0
MAX_FILES_PER_MESSAGE=5
MAX_RETRIES=2

# --- Режим памяти ---
# "server" - контекст держит сам DeepSeek (один чат-тред, шлём только
#            последнее сообщение). Для простых клиентов и как дефолт здесь.
# "client" - клиент шлёт всю историю; мост сплющивает её в ОДНО сообщение и
#            каждый запрос начинает НОВЫЙ чат DeepSeek. Полностью stateless,
#            без утечки прошлых ответов. НУЖЕН для opencode / Kilo Code.
#            При передаче tools (function calling) клиент (opencode/kilo) сам
#            исполняет команды и чтение файлов, получая от моста стандартные
#            tool_calls в формате OpenAI.
MEMORY_MODE=server

# --- Селекторы для https://chat.deepseek.com (перепроверьте при смене UI) ---
SEL_MESSAGE_INPUT=textarea
SEL_SEND_BUTTON=div.ds-button--primary.ds-button--filled.ds-button--circle
SEL_ATTACH_BUTTON=input[type='file']
SEL_FILE_INPUT=input[type='file']
SEL_ASSISTANT_BLOCK=[class*='assistant-message-main-content']
SEL_LAST_RESPONSE=[class*='assistant-message-main-content']:last-of-type
SEL_LOADING_INDICATOR=div[class*='loading'], div[class*='stop']
SEL_CHALLENGE_OVERLAY=#cf-overlay
CHALLENGE_TEXT=One more step before you proceed
SEL_DEEP_THINK_BUTTON=
SEL_SEARCH_BUTTON=
DEEP_THINK_LABELS=DeepThink,Deep Think,Глубокое мышление,Глубокое размышление
SEARCH_LABELS=Умный поиск,Search,Поиск,Веб-поиск
SEL_LOGGED_IN_MARKER=textarea
SEL_NEW_CHAT_BUTTON=
NEW_CHAT_LABELS=New chat,Новый чат,Создать чат,新对话,Nouvelle conversation
SEL_LOGIN_FORM_MARKER=form
SEL_MESSAGE_ITEM=div[class*='ds-message']:not([class*='main-content'])
SEL_MESSAGE_EDIT_BUTTON=button[class*='edit'], div[class*='edit'], [aria-label*='Edit']
SEL_MESSAGE_EDIT_INPUT=textarea
SEL_MESSAGE_EDIT_SAVE=button:has-text('Save'), button[type='submit']
SEL_REGENERATE_BUTTON=xpath=//div[@role='button' and .//*[local-name()='path'][starts-with(@d, 'M7.92136')]]

VALIDATION_URL=

SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_RESULTS_LIMIT=5

# Системный промпт вшивается в сообщение (UI DeepSeek не имеет отдельного поля).
# Обязательные плейсхолдеры: {system} и {user}.
SYSTEM_PROMPT_TEMPLATE=SYSTEM INSTRUCTION:\n{system}\n\nFollow the SYSTEM INSTRUCTION above for this and all subsequent responses. Now the user asks:\n\n{user}

# Выбор режима Deepseek через поле model (name:deep_think:search, d=0/1).
MODE_TOGGLES=deepseek-chat:0:0,deepseek-think:1:0,deepseek-search:0:1,deepseek-think-search:1:1
